FROM node:24-alpine AS build-stage

ARG CURRENT_ENV=production

WORKDIR /app
COPY frontend/package*.json ./
RUN npm ci
COPY frontend/ ./
COPY env_files/${CURRENT_ENV}/frontend.env ./.env.production.local
RUN npm run build

# production stage
FROM nginx:1.29-alpine AS production-stage
COPY config/common/frontend-nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build-stage /app/dist /usr/share/nginx/html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]

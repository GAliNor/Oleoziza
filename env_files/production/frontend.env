# Baked into the build by docker/frontend/Dockerfile-deploy. mock until the backend ships, then api
VITE_DATA_SOURCE=mock
VITE_APP_API_BASE_URL=/api
VITE_MOCK_LATENCY_MS=300
# public key that verifies access tokens (ES256 JWK); replace with the backend's key in api mode
VITE_AUTH_PUBLIC_JWK={"kty":"EC","x":"2ZyoYGkBS_kqBwM6bzvl6GCRD5c1UrjzQDJrGB2eC9I","y":"iaM0Ahx6v7YNSrj2--BhPRiLkT8VGW3-zG1aiEpvo9w","crv":"P-256"}

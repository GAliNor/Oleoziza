CURRENT_ENV=production

# Cloudflare Tunnel: the server opens no inbound port; cloudflared dials out and the tunnel's public hostname points at http://oleoziza_frontend:80
CLOUDFLARE_TUNNEL_TOKEN=change-me (Zero Trust > Networks > Tunnels > the tunnel's token)

# Versions
POSTGRE_BACKEND_VERSION=16.2-bullseye
REDIS_VERSION=8.10.3-alpine
CLOUDFLARED_VERSION=2026.10.0

# DB
DB_USERNAME=root
DB_PASSWORD=change-me
DB_DATABASE=oleoziza

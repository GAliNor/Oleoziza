CURRENT_ENV=production
# Own compose project, so production volumes never mix with the dev stack's (both compose files share this folder)
COMPOSE_PROJECT_NAME=oleoziza-production

# Public address: <server-ip>.sslip.io until a domain is bought. The certificate, CORS_ALLOWED_ORIGINS and RUSTFS_PUBLIC_ENDPOINT_URL (https://<PUBLIC_HOST>) all follow it
PUBLIC_HOST=change-me
# Let's Encrypt account contact (also enables the ZeroSSL fallback); unrelated to sending mail
ACME_EMAIL=change-me
# Only on the shared test server: Maroc Voyages' hosts this Caddy also serves (maroc-voyages.<server-ip>.sslip.io and maroc-voyages-files.<server-ip>.sslip.io); leave empty elsewhere
MV_PUBLIC_HOST=
MV_FILES_HOST=

# Entry point: caddy (Let's Encrypt HTTPS, publishes 80, 443 and 443/udp) or tunnel (Cloudflare Tunnel, publishes nothing)
COMPOSE_PROFILES=caddy
# Only with COMPOSE_PROFILES=tunnel: Zero Trust > Networks > Tunnels > the tunnel's token; its public hostname points at http://oleoziza_frontend:80
CLOUDFLARE_TUNNEL_TOKEN=

# Versions
CADDY_VERSION=2.11.9-alpine
POSTGRE_BACKEND_VERSION=16.2-bullseye
REDIS_VERSION=8.10.3-alpine
CLOUDFLARED_VERSION=2026.10.0

# DB
DB_USERNAME=root
DB_PASSWORD=change-me
DB_DATABASE=oleoziza

# RustFS (S3 storage): publishes no port; the keys reach the backend and worker through compose
RUSTFS_VERSION=1.0.3
RUSTFS_ACCESS_KEY=change-me
RUSTFS_SECRET_KEY=change-me

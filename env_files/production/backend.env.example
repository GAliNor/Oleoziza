DB_DRIVER_NAME=postgresql+psycopg2
DB_HOST=oleoziza_db_backend
DB_PORT=5432

# Set by docker-compose-deploy.yml from docker.env: DB_USER, DB_PASSWORD and DB_NAME, and CORS_ALLOWED_ORIGINS and RUSTFS_PUBLIC_ENDPOINT_URL (https://<PUBLIC_HOST>)

# Mail settings
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@oleoziza.ma
MAIL_PORT=587
# the production SMTP provider; empty until one is chosen, and then invitations and email codes are not sent
MAIL_SERVER=

# RustFS (S3-compatible storage)
RUSTFS_INTERNAL_ENDPOINT_URL=http://oleoziza-rustfs:9000
RUSTFS_PRIVATE_BUCKET=oleoziza-private
RUSTFS_PUBLIC_BUCKET=oleoziza-public
RUSTFS_SIGNED_URL_EXPIRY_IN_SECONDS=900

# Redis and Celery (broker on DB 0, results on DB 1)
REDIS_HOST=oleoziza_redis
REDIS_PORT=6379
REDIS_PASSWORD=
CELERY_BROKER_DB=0
CELERY_RESULT_DB=1
# Redis DB 2 carries the Assistant's answer streams
REDIS_CACHE_DB=2

# Auth: ES256 private JWK signing access and refresh tokens; its public half goes in the front's VITE_AUTH_PUBLIC_JWK
AUTH_PRIVATE_JWK=change-me
AUTH_ACCESS_TOKEN_EXPIRY_IN_SECONDS=900
AUTH_REFRESH_TOKEN_EXPIRY_IN_SECONDS=2592000
# Refresh cookie: path must match where the auth router is reached; secure needs HTTPS, so false only for local HTTP
AUTH_REFRESH_COOKIE_PATH=/api/auth
AUTH_REFRESH_COOKIE_SECURE=true
AUTH_MAX_FAILED_LOGIN_ATTEMPTS=5
AUTH_LOCK_DURATION_IN_SECONDS=900

# Owner created by `python -m seeds owner`
SEED_OWNER_EMAIL=
SEED_OWNER_PASSWORD=
SEED_OWNER_FIRST_NAME=
SEED_OWNER_LAST_NAME=

# AI: Fernet master key sealing the provider keys an Owner saves (python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"); never commit a real one
AI_SECRETS_KEY=change-me

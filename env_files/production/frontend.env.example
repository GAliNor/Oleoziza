# Baked into the build by docker/frontend/Dockerfile-deploy. Comma-separated modules served by the backend; the rest stay on mocks
VITE_API_MODULES=auth,configuration,season,user,territory,site,client,reception,lot,finance,expense,activity,dashboard,task
VITE_APP_API_BASE_URL=/api
VITE_MOCK_LATENCY_MS=300
# public half of the backend's AUTH_PRIVATE_JWK; it verifies access tokens (ES256 JWK)
VITE_AUTH_PUBLIC_JWK=change-me

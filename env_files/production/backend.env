DB_DRIVER_NAME=postgresql+psycopg2
DB_USER=root
DB_PASSWORD=change-me
DB_HOST=oleoziza_db_backend
DB_NAME=oleoziza
DB_PORT=5432

# comma-separated origins, or *
CORS_ALLOWED_ORIGINS=*

# Mail settings
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@oleoziza.ma
MAIL_PORT=1025
MAIL_SERVER=oleoziza_mailhog

# RustFS (S3-compatible storage)
RUSTFS_INTERNAL_ENDPOINT_URL=http://oleoziza-rustfs:9000
RUSTFS_PUBLIC_ENDPOINT_URL=http://localhost:32590
RUSTFS_ACCESS_KEY=change-me
RUSTFS_SECRET_KEY=change-me
RUSTFS_PRIVATE_BUCKET=oleoziza-private
RUSTFS_PUBLIC_BUCKET=oleoziza-public
RUSTFS_SIGNED_URL_EXPIRY_IN_SECONDS=900

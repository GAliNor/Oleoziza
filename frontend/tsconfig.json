{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "jsx": "preserve",
    "types": ["vite/client", "vite-plugin-pwa/vue"],
    "baseUrl": ".",
    "paths": {
      "~/*": ["src/*"],
      "map": ["src/lib/map/index.ts"],
      "map/*": ["src/lib/map/*"],
      "global/*": ["src/modules/global/*"],
      "dashboard/*": ["src/modules/dashboard/*"],
      "auth/*": ["src/modules/auth/*"],
      "site/*": ["src/modules/site/*"],
      "reception/*": ["src/modules/reception/*"],
      "client/*": ["src/modules/client/*"],
      "user/*": ["src/modules/user/*"],
      "task/*": ["src/modules/task/*"],
      "finance/*": ["src/modules/finance/*"],
      "configuration/*": ["src/modules/configuration/*"],
      "lot/*": ["src/modules/lot/*"],
      "kit/*": ["src/modules/kit/*"],
      "territory/*": ["src/modules/territory/*"],
      "activity/*": ["src/modules/activity/*"]
    }
  },
  "include": ["env.d.ts", "src/**/*.ts", "src/**/*.vue"]
}
